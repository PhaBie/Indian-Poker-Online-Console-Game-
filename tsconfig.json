{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["bun-types"]
  },
  "include": [
    "src/**/*",
    "Test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
