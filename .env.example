# Server administrator only. Never distribute NGROK_AUTHTOKEN with clients.
NGROK_AUTHTOKEN=
# Optional domain assigned to your ngrok account (hostname only).
NGROK_DOMAIN=
ONLINE_PORT=8081
# LAN server: set to the private IPv4 address of the intended network interface.
# LAN_HOST=192.168.1.10
PORT=8080
# Public endpoint for the client; no account/token needed by players.
POKER_ONLINE_URL=
